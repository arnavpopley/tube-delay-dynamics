# TfL Unified API keys from https://api-portal.tfl.gov.uk/
# Subscribe to the "500 Requests per min" product, then copy the keys
# from your profile. The collector uses TFL_APP_KEY. Keep the secondary
# as a spare; do not commit either value.
TFL_APP_KEY=
TFL_APP_KEY_SECONDARY=

# Seconds between poll cycles. One cycle = one Arrivals request + one
# Status request for all 11 lines (comma-separated, never fanned out).
# Commit any change to this value — polling frequency matters when
# interpreting gaps later.
POLL_INTERVAL_SECONDS=30

# Seconds without a successful poll before the collector logs CRITICAL
# and the healthcheck script exits non-zero.
HEALTH_STALE_SECONDS=600

# Bind a tiny JSON status server (heartbeat only, never raw JSONL).
# 0 = off. The systemd installer sets 8080 so Vercel can proxy it.
HEALTH_HTTP_PORT=0

# Root for data/raw and data/processed. Relative paths are resolved
# against the repo root.
DATA_DIR=data

LOG_LEVEL=INFO
